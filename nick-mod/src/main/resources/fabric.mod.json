  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.iikka.nick.NickMod"],
    "client": ["com.iikka.nick.NickClient"]
  },
  "mixins": ["nick.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
